DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/ai_research_scientist
JWT_SECRET_KEY=replace_with_a_long_random_secret_key_minimum_32_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:5173

# Free Agentic RAG Configuration (Local / Open-Source)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_STORE_PATH=./data/chroma
RAG_TOP_K=5
MAX_RETRIEVAL_ITERATIONS=2
